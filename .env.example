# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# PostgreSQL connection string (Neon). Create a free project at
# https://neon.tech, then copy the pooled connection string from the
# dashboard. Must include ?sslmode=require.
DATABASE_URL="postgresql://<user>:<password>@<host>/<dbname>?sslmode=require"

# NextAuth v5 JWT signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Vercel Blob token for product image uploads.
# Create a Blob store in the Vercel dashboard (Storage -> Blob) and
# copy its read/write token, or run `vercel env pull` in a linked project.
BLOB_READ_WRITE_TOKEN=""

# Resend (https://resend.com) API key and sender address, used for
# password-reset emails.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Public base URL of the app, used to build links in outgoing emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
